# Copy to .env (gitignored) and fill in values from Toss Securities WTS,
# Settings > Open API. Never commit the real values; never paste them into chat.
# Only the named research/auth settings below are read (allowlist in config.py).
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=

# SEC public data has no API key. Supply your own application/contact identity.
SEC_USER_AGENT=
# Optional OpenDART registration key (separate from ChatGPT).
OPENDART_API_KEY=
# Optional, separately billed API. Not needed for packet / ai-import workflow.
OPENAI_API_KEY=
OPENAI_MODEL=

# Note: the live order guard TOSS_PILOT_ALLOW_LIVE_ORDERS is deliberately NOT
# readable from this file. It must be set in the process environment for the
# single run that needs it, so it can never linger invisibly in a file.
